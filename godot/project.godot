; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Neon Tether"
config/description="A fast-paced, portrait rhythm-arcade physics runner — split and merge a tethered pair of spheres to dodge obstacles and collect Volt Crystals."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.043, 0.043, 0.086, 1)

[autoload]

SaveSystem="*res://autoload/SaveSystem.gd"
GameState="*res://autoload/GameState.gd"
AudioSynth="*res://autoload/AudioSynth.gd"

[display]

window/size/viewport_width=450
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
