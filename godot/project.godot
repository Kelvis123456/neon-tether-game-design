; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes as a comment above key value pairs.
;
config_version=5

[application]

config/name="Neon Tether"
config/description="A fast-paced, portrait rhythm-arcade physics runner — split and merge a tethered pair of spheres to dodge obstacles and collect Volt Crystals."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.043, 0.043, 0.086, 1)

[autoload]

SaveSystem="*res://autoload/SaveSystem.gd"
GameState="*res://autoload/GameState.gd"
AudioSynth="*res://autoload/AudioSynth.gd"

[display]

window/size/viewport_width=450
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
